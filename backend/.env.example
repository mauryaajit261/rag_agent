# ─────────────────────────────────────────────────────────────────────────────
# mySetu AI — Backend environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit secrets.
# Field names here must match the `Settings` class in config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=mySetu AI
APP_VERSION=1.0.2
DEBUG=false                 # set true only for local development

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001                   # must match the frontend VITE_API_URL

# ── Supabase (REQUIRED — auth, chat memory, image storage) ───────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# CRITICAL: bypasses Row Level Security. Backend-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Pinecone (REQUIRED — knowledge vectors) ──────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=mysetu-ai
PINECONE_DIMENSION=768

# ── LLM (Ollama) ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 3b grounds far better than 1b. Pull it: `ollama pull llama3.2:3b`. Use a bigger
# model (e.g. llama3.1:8b, qwen2.5:7b-instruct) if your hardware allows.
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=4096          # holds prompt + all retrieved chunks (avoid truncation)
OLLAMA_NUM_PREDICT=1024      # max answer tokens (caps slow runaway generation)
OLLAMA_KEEP_ALIVE=1800       # seconds to keep models warm between requests (30m)
OLLAMA_TEMPERATURE=0.1       # low = factual/precise

# ── RAG tuning (see the rag-pipeline skill before changing) ──────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=250
TOP_K_RETRIEVAL=10
RERANK_TOP_N=4
RERANKING_MODEL=ms-marco-TinyBERT-L-2-v2
SIMILARITY_THRESHOLD=0.40
MIN_CONFIDENCE_THRESHOLD=0.60

# ── File upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Database connector ───────────────────────────────────────────────────────
DB_CONNECTION_TIMEOUT=10
DB_MAX_ROWS_PER_QUERY=500

# ── Image persistence ────────────────────────────────────────────────────────
SUPABASE_IMAGES_BUCKET=chat-images
</content>
