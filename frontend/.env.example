# mySetu AI — Frontend environment template.
# Commit non-secret values in `.env`; put secret-ish values in `.env.local` (gitignored).

# Backend API base URL (must match the backend HOST:PORT)
VITE_API_URL=http://127.0.0.1:8001

# Supabase (anon key is public by design — safe in the client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# External image-analysis API token — put the real value in .env.local, NOT here.
# NOTE: VITE_* vars are embedded in the built bundle; prefer proxying via the backend.
VITE_IMAGE_API_TOKEN=your-image-api-token
</content>
